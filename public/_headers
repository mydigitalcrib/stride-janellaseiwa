# Read by Netlify and Cloudflare Pages. See "How private it is" in README.md.
# X-Robots-Tag: search engines must not list any page or keep a copy.
# Referrer-Policy: clicking through to TikTok or Reddit must not tell them this site's address.
# Content-Security-Policy: the page may only load its own files, and nothing can frame it.
# Permissions-Policy: the page never gets the camera, microphone, location or payments.
# The rest: HTTPS only, no embedding, no guessing at file types, no sharing a window with other sites.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
